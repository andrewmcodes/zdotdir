#? Allow-list, not deny-list: ignore every dotfile and dot-directory, then re-admit
#? the ones that are actually part of the config. A machine-local dotfile that lands
#? in $ZDOTDIR therefore can't be committed by accident — it has to be named here.
.*

#? Re-admits. `.github/` has to be listed explicitly: `.*` matches the DIRECTORY, and
#? git can't re-include a file whose parent dir is excluded, so without this line every
#? file under it would silently fall out of tracking.
!.github/
!.gitignore
!.zprofile
!.zshenv
!.zshrc
!.zstyles
!.zunit.yml

#* Notable things `.*` covers, so they are deliberately NOT re-admitted:
#*   .zsh_history — /etc/zshrc:16 sets HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history, i.e.
#*     inside this repo. rc.d/01-hist.zsh moves it, but if that ever failed to load
#*     zsh would write history here; the entry is defensive, not obsolete.
#*   .claude/, .ai/ — agent state, machine-local.
#*   .revolver/ — revolver (zunit's spinner) runtime state.
#*   .DS_Store — a pattern with no slash matches a basename at any depth, so nested
#*     ones (e.g. .github/.DS_Store) are covered too, not just the repo root.

#* Generated by `antidote bundle` (never hand-edited) but load-bearing — .zshrc sources
#* it directly and regenerates it whenever antidote_plugins.conf is newer.
antidote_plugins.zsh

# zunit test output.
tests/_output/
