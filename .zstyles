#!/bin/zsh
#
# .zstyles - Set zstyle settings for plugins that need them.
#

#
# Antidote
#

: ${ANTIDOTE_HOME:=${XDG_CACHE_HOME:-~/.cache}/repos}

zstyle ':antidote:bundle' file ${ZDOTDIR:-~}/antidote_plugins.conf
# Store clones as owner/repo (e.g. ~/.cache/repos/zsh-users/zsh-autosuggestions).
zstyle ':antidote:bundle' path-style 'short'

# Completions: cache + zcompile the zcompdump (skips insecure-dir checks; ~daily refresh).
#? No manual dump-clearing needed any more — rc.d/03-completion.zsh stamps $fpath
#? beside the dump and forces a rebuild whenever it changes.
zstyle ':plugin:ez-compinit' 'use-cache' 'yes'

#* No `list-colors` here. It used to be set from ${(s.:.)LS_COLORS}, but LS_COLORS
#* is never set anywhere in this config — so that line actively set the style to
#* an EMPTY value rather than being inert. compstyle_zshzoo_setup (the `post:`
#* hook on belak/zsh-utils) sets real colors on ':completion:*:default' instead.
#* If richer completion colors are ever wanted, set LS_COLORS statically in
#* .zshenv — `gdircolors` is installed but costs a fork.

zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:tldr:argument-1' fzf-preview 'tldr --color always $word'
# switch group using `,` and `.`
zstyle ':fzf-tab:*' switch-group ',' '.'

#* No `special-dirs` here either. compstyle_zshzoo_setup runs AFTER .zstyles and
#* sets `special-dirs ..`, so a value set here is silently overwritten — the old
#* `special-dirs false` never took effect. To actually exclude `..` from
#* completion, set it from an rc.d file (which loads after the plugins).
